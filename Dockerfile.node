FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    curl ca-certificates tar nodejs npm \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Download substrate-contracts-node
RUN curl -L -o node.tar.gz \
    "https://github.com/paritytech/substrate-contracts-node/releases/download/v0.41.0/substrate-contracts-node-linux.tar.gz" \
    && tar -xzvf node.tar.gz \
    && find . -name "substrate-contracts-node" -type f -exec mv {} ./substrate-contracts-node \; \
    && chmod +x ./substrate-contracts-node \
    && rm -rf node.tar.gz artifacts \
    && ./substrate-contracts-node --version

# Install ws-proxy inline
RUN npm install http-proxy ws

COPY <<'JSEOF' proxy.js
const http = require("http");
const httpProxy = require("http-proxy");

const TARGET = "http://127.0.0.1:9944";
const PORT = process.env.PORT || 8080;

const proxy = httpProxy.createProxyServer({ target: TARGET, ws: true });

proxy.on("error", (e) => console.error("Proxy error:", e.message));

const server = http.createServer((req, res) => {
  proxy.web(req, res);
});

server.on("upgrade", (req, socket, head) => {
  proxy.ws(req, socket, head);
});

server.listen(PORT, "0.0.0.0", () => {
  console.log("Proxy listening on port " + PORT);
});
JSEOF

COPY <<'SHEOF' start.sh
#!/bin/sh
set -e

echo "==> Starting substrate-contracts-node on :9944"
./substrate-contracts-node \
  --dev \
  --rpc-external \
  --rpc-cors=all \
  --rpc-methods=unsafe \
  --rpc-port=9944 &

NODE_PID=$!
echo "==> Node PID: $NODE_PID"

echo "==> Waiting for node RPC..."
TRIES=0
until curl -sf -X POST -H "Content-Type: application/json" \
  -d '{"id":1,"jsonrpc":"2.0","method":"system_health","params":[]}' \
  http://127.0.0.1:9944 > /dev/null; do
  TRIES=$((TRIES+1))
  if [ $TRIES -gt 30 ]; then
    echo "==> Node failed to start after 60s"
    exit 1
  fi
  echo "==> Attempt $TRIES — waiting 2s..."
  sleep 2
done

echo "==> Node ready! Starting proxy on :${PORT}"
exec node proxy.js
SHEOF

RUN chmod +x start.sh

EXPOSE 8080
CMD ["./start.sh"]
