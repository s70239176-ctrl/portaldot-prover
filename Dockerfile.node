FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    curl ca-certificates tar nodejs npm \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN curl -L -o node.tar.gz \
    "https://github.com/paritytech/substrate-contracts-node/releases/download/v0.41.0/substrate-contracts-node-linux.tar.gz" \
    && tar -xzvf node.tar.gz \
    && find . -name "substrate-contracts-node" -type f -exec mv {} ./substrate-contracts-node \; \
    && chmod +x ./substrate-contracts-node \
    && rm -rf node.tar.gz artifacts

RUN npm install http-proxy ws

RUN cat > proxy.js << 'JSEOF'
const http = require("http");
const httpProxy = require("http-proxy");

// Node always runs on 9944
// Proxy listens on PORT (set by Railway) — must be different from 9944
const NODE_PORT = 9944;
const PROXY_PORT = process.env.PORT || 3000;

console.log("Node port:", NODE_PORT);
console.log("Proxy port:", PROXY_PORT);

const proxy = httpProxy.createProxyServer({
  target: "http://127.0.0.1:" + NODE_PORT,
  ws: true,
});

proxy.on("error", (e) => console.error("Proxy error:", e.message));

const server = http.createServer((req, res) => {
  proxy.web(req, res);
});

server.on("upgrade", (req, socket, head) => {
  proxy.ws(req, socket, head);
});

server.listen(PROXY_PORT, "0.0.0.0", () => {
  console.log("==> Proxy listening on port " + PROXY_PORT);
  console.log("==> Forwarding to node on port " + NODE_PORT);
});
JSEOF

RUN cat > start.sh << 'SHEOF'
#!/bin/sh
echo "==> Starting substrate-contracts-node on :9944"
./substrate-contracts-node \
  --dev \
  --rpc-external \
  --rpc-cors=all \
  --rpc-methods=unsafe \
  --rpc-port=9944 &

echo "==> Waiting for node..."
TRIES=0
until curl -sf -X POST -H "Content-Type: application/json" \
  -d '{"id":1,"jsonrpc":"2.0","method":"system_health","params":[]}' \
  http://127.0.0.1:9944 > /dev/null 2>&1; do
  TRIES=$((TRIES+1))
  if [ $TRIES -gt 30 ]; then echo "Node failed to start"; exit 1; fi
  echo "Waiting... attempt $TRIES"
  sleep 2
done

echo "==> Node ready on :9944, starting proxy on :${PORT}"
exec node proxy.js
SHEOF

RUN chmod +x start.sh

EXPOSE 3000
CMD ["./start.sh"]
